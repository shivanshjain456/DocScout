# DocScout environment template. Copy to .env and fill in. NEVER commit .env.
# Values here are placeholders only (guardrail §1.4).

# --- local data layer (generate with: openssl rand -hex 24) ---
DB_PASSWORD=
DB_APP_PASSWORD=
DATABASE_URL=postgresql://docscout:${DB_PASSWORD}@localhost:5432/docscout
REDIS_URL=redis://localhost:6379/0

# --- serving API (generate with: openssl rand -hex 24) ---
# Comma-separated to allow rotation without downtime. The API refuses to start if this is
# empty: auth that disables itself when a variable is missing is a hole, not a default.
DOCSCOUT_API_KEY=
# Requests per key per minute (default 60). There is no value that disables the limiter.
DOCSCOUT_RATE_LIMIT_PER_MINUTE=

# --- LLM providers (Phase 0: NOT provisioned, see SETUP_REPORT §9) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- github (fine-grained PAT, repo docscout only, Contents RW / Issues RW / PR RW / Metadata RO) ---
GITHUB_PAT=

# --- cloud (deploy phase only; Phase 0 creates no resources) ---
CLOUD=aws
DEPLOY_REGION=

# --- local model cache (kept outside the repo tree) ---
HF_HOME=

# --- third-party telemetry opt-outs (see docs/security/skills-audit.md) ---
DEEPEVAL_TELEMETRY_OPT_OUT=YES
SUPERPOWERS_DISABLE_TELEMETRY=true
