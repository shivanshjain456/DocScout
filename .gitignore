# --- secrets (guardrail §1.4: .env is gitignored from the FIRST commit) ---
.env
.env.*
!.env.example
*.pem
*.key

# --- corpus & generated reports ---
# Anchor with a leading slash. An UNANCHORED `corpus/` matches a directory named `corpus` at ANY
# depth, which silently swallowed docs/corpus/ — the home of CORPUS_SPEC.md. Caught by ADR-0001's
# pre-commit inspection; the deliverable would otherwise have been excluded without any error.
/corpus/*
# The manifest is the corpus's provenance anchor: identity, hashes and fetch timestamps for every
# document, and the thing that makes the raw bytes re-derivable (CORPUS_SPEC.md C-6, C-18, and the
# reproducibility fields in EVAL_PROTOCOL.md E-14). Track the manifest; ignore the bytes it names.
!/corpus/raw/
/corpus/raw/*
!/corpus/raw/manifest.json
# Eval run outputs are untracked by default -- a repo should not accumulate every
# exploratory run. The PINNED baseline is the exception and is force-added: EVAL_PROTOCOL
# E-13 says a metric does not exist unless its raw output does, so the run the README
# quotes has to be in the repository, not merely on the machine that produced it.
evals/reports/*
!evals/reports/20261001T192924Z/
# Ingest run reports. The working output of `make ingest` is untracked like every other
# generated report; the curated evidence for a milestone is committed under
# docs/corpus/evidence/ instead, so the repo keeps the run it cites and not every run.
/corpus/reports/
# Ad-hoc `make load` runs are ignored, EXCEPT the pinned verification run: V15 of
# scripts/verify_setup.sh asserts that report exists, so leaving it untracked made the matrix
# depend on an artifact git would not keep — the same defect class as the corpus manifest above.
# Note the `/*` form: git will not descend into an excluded DIRECTORY, so `loadtests/reports/`
# followed by a negation silently does nothing. Verified with `git check-ignore -v`.
loadtests/reports/*
!loadtests/reports/verify/
loadtests/dummy_server.py

# --- python ---
.venv/
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/

# --- node / ui ---
node_modules/
ui/dist/
.playwright/
playwright-report/
test-results/

# --- models / weights / caches ---
*.pt
*.bin
*.safetensors
.hf_cache/

# --- git history bundle (see scripts/git_history.sh) ---
# Binary, rewritten on every save, and it exists precisely because .git does not persist.
# Tracking it inside the repo it backs up would be circular.
.history/

# --- os ---
.DS_Store
